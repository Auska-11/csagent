# 复制为 .env 后填写真实值。
# 不要把 .env 提交到仓库。

OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=your-model-name

# 本地工作台默认开启 demo JWT 签发；生产环境必须关闭，并替换至少 32 字节的随机密钥。
SMARTCS_SECURITY_DEMO_ISSUER_ENABLED=true
SMARTCS_SECURITY_ISSUER=smart-cs-agent
SMARTCS_SECURITY_AUDIENCE=smart-cs-api
SMARTCS_SECURITY_DEFAULT_TENANT_ID=default
SMARTCS_SECURITY_JWT_SECRET=replace-with-at-least-32-random-bytes
SMARTCS_SECURITY_TOKEN_TTL_SECONDS=28800
SMARTCS_SECURITY_CLOCK_SKEW_SECONDS=30

# 仅在 mcp-remote / hybrid 模式需要：远程 MCP 服务签发的 MCP_CLIENT Bearer JWT。
SMARTCS_MCP_REMOTE_TOKEN=

# 默认 local，不依赖外部向量库；需要演示真 embedding + Qdrant 时改成 embedding-qdrant。
SMARTCS_RAG_MODE=local
SMARTCS_EMBEDDING_BASE_URL=https://api.openai.com/v1
SMARTCS_EMBEDDING_API_KEY=your-api-key
SMARTCS_EMBEDDING_MODEL_NAME=text-embedding-3-small
SMARTCS_EMBEDDING_DIMENSIONS=1536
SMARTCS_EMBEDDING_CONNECT_TIMEOUT_MS=3000
SMARTCS_EMBEDDING_READ_TIMEOUT_MS=10000
SMARTCS_QDRANT_BASE_URL=http://localhost:6333
SMARTCS_QDRANT_COLLECTION=smart_cs_knowledge
SMARTCS_QDRANT_CONNECT_TIMEOUT_MS=3000
SMARTCS_QDRANT_READ_TIMEOUT_MS=10000

# 长期偏好默认 30 天过期，并限制用户数、每用户条数、单条长度和会话摘要长度。
SMARTCS_MEMORY_PREFERENCE_TTL_MS=2592000000
SMARTCS_MEMORY_MAX_USERS=10000
SMARTCS_MEMORY_MAX_PREFERENCES_PER_USER=20
SMARTCS_MEMORY_MAX_PREFERENCE_LENGTH=80
SMARTCS_MEMORY_SUMMARY_MAX_LENGTH=2000

# 默认 memory，不依赖售后工单平台；需要联调桌面 demo 后端时改成 after-sales-http。
SMARTCS_HANDOFF_MODE=memory
SMARTCS_AFTER_SALES_BASE_URL=http://localhost:8081
SMARTCS_AFTER_SALES_TENANT_ID=demo
SMARTCS_AFTER_SALES_AGENT_USER_ID=agent-service
SMARTCS_AFTER_SALES_AGENT_USER_ROLE=AGENT
SMARTCS_AFTER_SALES_CONNECT_TIMEOUT_MS=3000
SMARTCS_AFTER_SALES_READ_TIMEOUT_MS=10000
# 确认售后平台按 Idempotency-Key 去重后才开启；否则自动补建可能产生重复工单。
SMARTCS_HANDOFF_RECOVERY_ENABLED=false
SMARTCS_HANDOFF_RECOVERY_BATCH_SIZE=10
SMARTCS_HANDOFF_RECOVERY_FIXED_DELAY_MS=5000
SMARTCS_HANDOFF_RECOVERY_PREPARED_GRACE_MS=30000
SMARTCS_HANDOFF_RECOVERY_LEASE_MS=30000
SMARTCS_HANDOFF_RECOVERY_RETRY_DELAY_MS=5000
SMARTCS_HANDOFF_RECOVERY_MAX_RETRY_DELAY_MS=60000
SMARTCS_HANDOFF_RECOVERY_MAX_ATTEMPTS=3

# 默认 memory，不依赖数据库；需要演示 MySQL 持久化时改成 jdbc。
SMARTCS_PERSISTENCE_MODE=memory
# 这个文件主要供 Docker Compose 使用；容器访问宿主机 MySQL 要使用 host.docker.internal。
SMARTCS_JDBC_DRIVER=com.mysql.cj.jdbc.Driver
SMARTCS_JDBC_URL=jdbc:mysql://host.docker.internal:3306/smart_cs_agent?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
SMARTCS_JDBC_USERNAME=root
SMARTCS_JDBC_PASSWORD=your-password
# 三层超时避免数据库异常时请求和 readiness 一直阻塞。
SMARTCS_JDBC_CONNECT_TIMEOUT_MS=3000
SMARTCS_JDBC_SOCKET_TIMEOUT_MS=10000
SMARTCS_JDBC_QUERY_TIMEOUT_SECONDS=5
