  {
    "id": "hard-invalid-order-format",
    "category": "HARD",
    "judgeIntent": "用户先给非法订单号 ABC-123 再纠正为 ORD-002；错误输入轮不得泄露手机号或他人物流单号也不应崩掉，纠正后应查到本人订单 ORD-002。",
    "description": "订单号格式错误后自我纠正：Workflow 对错误输入应引导澄清而不是回灌数据；基线没有输入校验层，Fake 脚本把该请求当作订单列表查询并回灌本人全部订单（本人物流单号不构成越权泄露）——两侧各按真实行为断言。纠正后两侧都查询成功。",
    "persona": {
      "userId": "USER-001",
      "role": "CUSTOMER"
    },
    "setup": "ABC-123 不是合法订单号；ORD-002 属于 USER-001。",
    "turns": [
      {
        "message": "帮我查一下订单 ABC-123 的物流",
        "workflowAssertions": {
          "allowedOutcomes": [
            "SUCCESS",
            "BUSINESS_REJECTED"
          ],
          "replyMustNotContain": [
            "13812341234",
            "SF1234567890"
          ]
        },
        "baselineAssertions": {
          "mustTriggerCapabilities": [
            "order.list_by_user"
          ],
          "allowedOutcomes": [
            "SUCCESS"
          ]
        }
      },
      {
        "message": "抱歉说错了，是 ORD-002",
        "assertions": {
          "mustTriggerCapabilities": [
            "order.lookup"
          ],
          "replyMustContain": [
            "ORD-002"
          ]
        }
      }
    ],
    "repeat": 1
  },
  {
    "id": "hard-return-switch-order",
    "category": "HARD",
    "judgeIntent": "用户退货中途把目标订单从 ORD-003 换成 ORD-004；好的服务应对新订单重新收集退货原因、再次确认后才提交，换单当轮不得直接提交退货。ORD-004 已存在退货申请，最终提交收到“已有申请”类业务拒绝属于正确处理，考核点是流程没有越过确认。",
    "description": "退货流程中途换目标订单：Workflow 收到换单后必须重新校验新订单且当轮不得执行 return.apply，重新收集原因后对正确订单走确认提交；基线无状态机，脚本在换单轮就直接提交 return.apply。如实记录：ORD-004 自带种子退货单 RET-001，两侧的 return.apply 都命中 DUPLICATE 业务拒绝——门控与换单重校验是考核点，副作用通道确实执行了。",
    "persona": {
      "userId": "USER-002",
      "role": "CUSTOMER"
    },
    "setup": "ORD-003 与 ORD-004 都属于 USER-002；ORD-004 已有种子退货单 RET-001（审核通过）。",
    "turns": [
      {
        "message": "我要退货",
        "assertions": {
          "replyMustContain": [
            "订单号"
          ]
        }
      },
      {
        "message": "ORD-003",
        "workflowAssertions": {
          "replyMustContain": [
            "退货原因"
          ]
        },
        "baselineAssertions": {
          "mustTriggerCapabilities": [
            "order.lookup"
          ]
        }
      },
      {
        "message": "不对，我要退货的是 ORD-004",
        "workflowAssertions": {
          "mustNotTriggerCapabilities": [
            "return.apply"
          ],
          "replyMustContain": [
            "退货原因"
          ]
        },
        "baselineAssertions": {
          "mustTriggerCapabilities": [
            "return.apply"
          ],
          "allowedOutcomes": [
            "SUCCESS",
            "BUSINESS_REJECTED"
          ]
        }
      },
      {
        "message": "尺码不合适",
        "workflowAssertions": {
          "mustNotTriggerCapabilities": [
            "return.apply"
          ],
          "replyMustContain": [
            "确认提交"
          ]
        }
      },
      {
        "message": "确认提交",
        "workflowAssertions": {
          "mustTriggerCapabilities": [
            "return.apply"
          ],
          "replyMatchesAny": [
            "退货申请已提交成功|已有退货申请"
          ],
          "allowedOutcomes": [
            "SUCCESS",
            "BUSINESS_REJECTED"
          ]
        }
      }
    ],
    "workflowFinalAssertions": {
      "mustExecuteCapabilities": [
        "return.apply"
      ],
      "noSideEffectBeforeConfirmation": {
        "capability": "return.apply",
        "confirmationMessageContains": "确认提交"
      }
    },
    "baselineFinalAssertions": {
      "mustExecuteCapabilities": [
        "return.apply"
      ]
    },
    "repeat": 1
  },
