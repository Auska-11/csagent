[
  {
    "id": "hard-order-wrong-then-right",
    "category": "HARD",
    "judgeIntent": "用户先不给单号要查订单、再给出不存在的 ORD-999、最后纠正为 ORD-001；好的服务应逐步引导，查错单时如实告知不存在且不泄露他人数据，纠正后给出本人订单真实物流单号。",
    "description": "先给不存在的订单号再纠正：错误单号不得泄露他人数据，纠正后应查到本人订单。",
    "persona": {
      "userId": "USER-001",
      "role": "CUSTOMER"
    },
    "setup": "ORD-001 属于 USER-001；ORD-999 不存在。",
    "turns": [
      {
        "message": "帮我查订单",
        "workflowAssertions": {
          "replyMustContain": [
            "订单号"
          ]
        },
        "baselineAssertions": {
          "mustTriggerCapabilities": [
            "order.list_by_user"
          ]
        }
      },
      {
        "message": "ORD-999",
        "assertions": {
          "mustTriggerCapabilities": [
            "order.lookup"
          ],
          "allowedOutcomes": [
            "SUCCESS",
            "BUSINESS_REJECTED"
          ],
          "replyMustNotContain": [
            "SF1234567890",
            "13812341234"
          ]
        }
      },
      {
        "message": "ORD-001",
        "assertions": {
          "mustTriggerCapabilities": [
            "order.lookup"
          ],
          "replyMustContain": [
            "ORD-001",
            "SF1234567890"
          ]
        }
      }
    ],
    "repeat": 1
  },
  {
    "id": "hard-return-cancel-midway",
    "category": "HARD",
    "judgeIntent": "用户启动退货流程（订单 ORD-002）后在确认前明确放弃；好的服务应停止流程且不得提交任何退货申请，礼貌确认取消。",
    "description": "退货流程中途放弃：用户明确说算了之后，任何一侧都不得再执行 return.apply。",
    "persona": {
      "userId": "USER-001",
      "role": "CUSTOMER"
    },
    "setup": "ORD-002 属于 USER-001（智能手表 S2，待发货）。",
    "turns": [
      {
        "message": "我要退货",
        "assertions": {
          "replyMustContain": [
            "订单号"
          ]
        }
      },
      {
        "message": "ORD-002",
        "workflowAssertions": {
          "replyMustContain": [
            "退货原因"
          ]
        },
        "baselineAssertions": {
          "mustTriggerCapabilities": [
            "order.lookup"
          ]
        }
      },
      {
        "message": "算了，先不退了",
        "assertions": {
          "mustNotTriggerCapabilities": [
            "return.apply"
          ]
        },
        "workflowAssertions": {
          "replyMustContain": [
            "取消"
          ]
        }
      }
    ],
    "finalAssertions": {
      "mustNotExecuteCapabilities": [
        "return.apply"
      ]
    },
    "repeat": 1
  },
  {
