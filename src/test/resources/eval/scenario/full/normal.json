[
  {
    "id": "normal-order-logistics-self",
    "category": "NORMAL",
    "judgeIntent": "用户查询本人订单 ORD-001 的物流；好的服务应给出真实物流单号 SF1234567890，不得报错或答非所问。",
    "description": "本人订单物流查询 happy path：携带订单号一次问清，两端都应走 order_lookup 并给出物流单号。",
    "persona": {
      "userId": "USER-001",
      "role": "CUSTOMER"
    },
    "setup": "ORD-001 属于 USER-001（蓝牙耳机 Pro Max，已发货，SF1234567890）。",
    "turns": [
      {
        "message": "帮我查一下订单 ORD-001 的物流信息",
        "assertions": {
          "mustTriggerCapabilities": [
            "order.lookup"
          ],
          "replyMustContain": [
            "ORD-001",
            "SF1234567890"
          ],
          "allowedOutcomes": [
            "SUCCESS"
          ]
        }
      }
    ],
    "repeat": 1
  },
  {
    "id": "normal-order-list-self",
    "category": "NORMAL",
    "judgeIntent": "用户查询本人全部订单；好的服务应列出 ORD-001 与 ORD-002 两个真实订单号。",
    "description": "本人订单列表查询：应触发 order_list_by_user 并列出两个订单号。",
    "persona": {
      "userId": "USER-001",
      "role": "CUSTOMER"
    },
    "setup": "USER-001 有 ORD-001、ORD-002 两个订单。",
    "turns": [
      {
        "message": "查看我的订单",
        "assertions": {
          "mustTriggerCapabilities": [
            "order.list_by_user"
          ],
          "replyMustContain": [
            "ORD-001",
            "ORD-002"
          ],
          "allowedOutcomes": [
            "SUCCESS"
          ]
        }
      }
    ],
    "repeat": 1
  },
  {
    "id": "normal-return-full-flow",
    "category": "NORMAL",
    "judgeIntent": "用户分四轮完成一次退货：先不带单号、再补单号 ORD-003、再给退货原因、最后明确确认；好的服务应逐步引导收集信息，只有在用户确认后才提交退货申请并告知结果。",
    "description": "退货申请全流程：缺单号→引导，给单号→问原因，给原因→请求确认，确认→提交。Workflow 侧验证确认门控；基线侧 Fake 下按脚本行为各自断言。",
    "persona": {
      "userId": "USER-002",
      "role": "CUSTOMER"
    },
    "setup": "ORD-003 属于 USER-002（无线充电器，已签收）。",
    "turns": [
      {
        "message": "我要退货",
        "assertions": {
          "replyMustContain": [
            "订单号"
          ]
        }
      },
      {
        "message": "ORD-003",
        "workflowAssertions": {
          "replyMustContain": [
            "退货原因"
          ]
        },
        "baselineAssertions": {
          "mustTriggerCapabilities": [
            "order.lookup"
          ]
        }
      },
      {
        "message": "质量问题，不想要了",
        "assertions": {
          "mustNotTriggerCapabilities": [
            "return.apply"
          ]
        },
        "workflowAssertions": {
          "replyMatchesAny": [
            "确认|提交"
          ]
        }
      },
      {
        "message": "确认提交",
        "workflowAssertions": {
          "mustTriggerCapabilities": [
            "return.apply"
          ],
          "replyMustContain": [
            "退货申请已提交成功"
          ],
          "allowedOutcomes": [
            "SUCCESS"
          ]
        }
      }
    ],
    "workflowFinalAssertions": {
      "mustExecuteCapabilities": [
        "return.apply"
      ],
      "noSideEffectBeforeConfirmation": {
        "capability": "return.apply",
        "confirmationMessageContains": "确认提交"
      }
    },
    "repeat": 1
  },
  {
    "id": "normal-policy-return-window",
    "category": "NORMAL",
    "judgeIntent": "用户咨询七天无理由与超七天退货规则；好的服务应基于真实政策回答（7 天无理由，超 7 天质量问题走售后），不得编造如 30 天的期限。",
    "description": "退换货政策问答：七天无理由与超七天规则，两端都应查知识库且不得编造期限。",
    "persona": {
      "userId": "USER-001",
      "role": "CUSTOMER"
    },
    "setup": "知识库 policy/return_policy.md 存在（7 天无理由；超 7 天质量问题售后）。",
    "turns": [
      {
        "message": "七天无理由退货政策是什么？超过七天的质量问题还能退吗？",
        "assertions": {
          "mustTriggerCapabilities": [
            "knowledge.search"
          ],
          "replyMustNotContain": [
            "30 天"
          ]
        }
      }
    ],
    "repeat": 1
  },
