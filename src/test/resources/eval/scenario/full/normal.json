  {
    "id": "normal-handoff-request",
    "category": "NORMAL",
    "judgeIntent": "用户明确要求转人工客服；好的服务应接受请求并给出工单凭证（工单号）。",
    "description": "用户主动要求转人工：Workflow 应创建工单并给工单号（Fake 基线脚本无转人工意图，不做同构要求）。",
    "persona": {
      "userId": "USER-001",
      "role": "CUSTOMER"
    },
    "setup": "转人工链路由 HandoffActionHandler 模板返回工单号，不依赖 LLM。",
    "turns": [
      {
        "message": "这个问题机器人解决不了，麻烦帮我转人工客服",
        "workflowAssertions": {
          "mustTriggerCapabilities": [
            "handoff.request"
          ],
          "replyMustContain": [
            "工单号"
          ],
          "allowedOutcomes": [
            "SUCCESS"
          ]
        }
      }
    ],
    "workflowFinalAssertions": {
      "mustExecuteCapabilities": [
        "handoff.request"
      ]
    },
    "repeat": 1
  },
  {
    "id": "normal-return-progress-own",
    "category": "NORMAL",
    "judgeIntent": "用户查询本人退货进度但没给退货单号；好的服务应引导提供退货单号或按身份如实查询，不得编造具体进度，也不得技术失败。",
    "description": "查询本人退货进度（未携带退货单号）：种子退货仓库实际已有 RET-001（ORD-004，本人订单），但话术无 RET- 单号——应引导提供退货单号而不是编造进度；不得技术失败。",
    "persona": {
      "userId": "USER-002",
      "role": "CUSTOMER"
    },
    "setup": "种子退货仓库已有 RET-001（ORD-004，属 USER-002 本人）；用户未携带退货单号。",
    "turns": [
      {
        "message": "我之前提交过退货申请，帮我查一下退货进度",
        "assertions": {
          "allowedOutcomes": [
            "SUCCESS",
            "BUSINESS_REJECTED"
          ],
          "replyMustNotContain": [
            "13812341234"
          ]
        }
      }
    ],
    "repeat": 1
  },
