  {
    "id": "fault-llm-timeout-return-confirm",
    "category": "FAULT",
    "judgeIntent": "两轮退货对话：第一轮用户给出订单 ORD-003 与原因（好的服务应先请求确认而不是直接提交），第二轮用户确认提交，同时 LLM 通道被注入超时；理想的服务应照常完成退货提交流程，确认轮整轮失败则任务未完成；若订单已有申请收到“已有退货申请”类业务拒绝属于正确处理。",
    "description": "确认轮 LLM 超时：Workflow 的 return.apply 提交与结果文案不经 LLM，确认轮应照常执行提交通道。如实记录：固定执行顺序下 Workflow 全量先跑已在 normal-return-full-flow 消耗 ORD-003，本场景确认轮 return.apply 命中 DUPLICATE 业务拒绝（门控行为正确、副作用通道确实执行）；基线第一轮无门控直接提交同样命中 DUPLICATE，第二轮 503。",
    "persona": {
      "userId": "USER-002",
      "role": "CUSTOMER"
    },
    "setup": "ORD-003 属于 USER-002；第二轮注入 llm=timeout。",
    "turns": [
      {
        "message": "我要退货 ORD-003，原因是质量问题",
        "workflowAssertions": {
          "mustNotTriggerCapabilities": [
            "return.apply"
          ],
          "replyMatchesAny": [
            "确认|提交"
          ]
        },
        "baselineAssertions": {
          "mustTriggerCapabilities": [
            "return.apply"
          ],
          "allowedOutcomes": [
            "SUCCESS",
            "BUSINESS_REJECTED"
          ]
        }
      },
      {
        "message": "确认提交",
        "faultInjection": {
          "llm": "timeout"
        },
        "workflowAssertions": {
          "mustTriggerCapabilities": [
            "return.apply"
          ],
          "replyMatchesAny": [
            "退货申请已提交成功|已有退货申请"
          ],
          "allowedOutcomes": [
            "SUCCESS",
            "BUSINESS_REJECTED"
          ]
        },
        "baselineAssertions": {
          "expectHttpOk": false,
          "allowedOutcomes": [
            "TECHNICAL_FAILURE"
          ]
        }
      }
    ],
    "workflowFinalAssertions": {
      "mustExecuteCapabilities": [
        "return.apply"
      ],
      "noSideEffectBeforeConfirmation": {
        "capability": "return.apply",
        "confirmationMessageContains": "确认提交"
      }
    },
    "repeat": 1
  },
