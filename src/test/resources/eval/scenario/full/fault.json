[
  {
    "id": "fault-llm-failure-chitchat",
    "category": "FAULT",
    "judgeIntent": "本轮用户找客服闲聊解闷，同时服务方 LLM 通道被注入了异常故障（对任何实现都相同）；好的服务应给出降级但不失礼貌的非空回复并正常返回，而不是让整轮请求失败。",
    "description": "纯闲聊轮 LLM 异常：Workflow 应模板降级存活（HTTP 200 + 非空回复）；基线无降级层，整轮 503——两侧各按自己的真实行为断言。M3 校准记录：原消息“新品推荐/优惠活动”实际路由到商品检索模板路径、免疫 LLM 故障（模板免疫这一结构性发现改由 fault-llm-timeout-policy-qa 等场景如实记录），此处改锚纯闲聊以真正覆盖 FAILURE 降级路径。",
    "persona": {
      "userId": "USER-001",
      "role": "CUSTOMER"
    },
    "setup": "故障注入 llm=failure；测试上下文 call-timeout-ms=600。",
    "turns": [
      {
        "message": "无聊死了，陪我聊会儿天呗",
        "faultInjection": {
          "llm": "failure"
        },
        "workflowAssertions": {
          "expectDegradedReply": true,
          "allowedOutcomes": [
            "TECHNICAL_FAILURE"
          ]
        },
        "baselineAssertions": {
          "expectHttpOk": false,
          "allowedOutcomes": [
            "TECHNICAL_FAILURE"
          ],
          "expectedErrorCode": "LLM_PROVIDER_ERROR"
        }
      }
    ],
    "repeat": 1
  },
