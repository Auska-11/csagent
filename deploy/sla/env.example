# /opt/sla/.env 模板（仅变量名与格式，真实值不入库）。
# 复制为 .env 后填入真实值；.env 只经 scp 传输、落盘 chmod 600，不入库、不打印。
#
# 生成方式见 docs/客服Agent/客服Agent-78-服务器部署手册.md 的 SLA 共部署章节：
# 基础设施密码用 openssl rand -hex 16 生成；JWT/服务账号/回调令牌沿用本地联调
# 已有值或重新生成，但必须与 agent 侧 .env 的 SMARTCS_HANDOFF_SLA_V1_* 一致。

SLA_MYSQL_DATABASE=sla
SLA_MYSQL_USER=sla
SLA_MYSQL_PASSWORD=<openssl-rand-hex-16>
SLA_MYSQL_ROOT_PASSWORD=<openssl-rand-hex-16>
SLA_MYSQL_PORT=3308

SLA_RABBITMQ_USERNAME=aftersales
SLA_RABBITMQ_PASSWORD=<openssl-rand-hex-16>
SLA_RABBITMQ_PORT=5673

# 卖家管理界面（http://127.0.0.1:8081，经 SSH 隧道访问）。
SLA_APP_PORT=8081

# prod profile：无默认值，缺失即启动失败。
SLA_APP_AUTH_JWT_SECRET=<至少32字节随机串>
SLA_APP_AUTH_BOOTSTRAP_USERNAME=seller-admin
SLA_APP_AUTH_BOOTSTRAP_PASSWORD=<管理员密码>
SLA_APP_AUTH_BOOTSTRAP_USER_ID=seller-admin-001
SLA_APP_AUTH_BOOTSTRAP_TENANT_ID=default

# v1 集成配置（Spring 标准外部化 JSON，compose 映射为 SPRING_APPLICATION_JSON）。
# agent-cs 是账号名（可自定义）；username/password 是 agent 侧
# SMARTCS_HANDOFF_SLA_V1_USERNAME/PASSWORD；seller-account-id/tenant-id 与
# SMARTCS_HANDOFF_SLA_V1_SELLER_ACCOUNT_ID/CALLBACK_TENANT_ID 一致；
# callback-token 与 SMARTCS_HANDOFF_SLA_V1_CALLBACK_TOKEN 一致。
# callback-url 固定指向 csagent_default 网络里的 agent 容器名。
SLA_APP_INTEGRATION_V1_JSON={"app":{"integration":{"v1":{"agent-users":{"agent-cs":{"password":"<至少12位>","service-user-id":"agent-service-cs","tenant-id":"default","seller-account-id":"seller-cs","default-handler-user-id":"seller-admin-001","callback-url":"http://smart-cs-agent:8080/api/integrations/v1/sla-results","callback-token":"<随机令牌>"}}}}}}

# 小内存服务器 JVM 封顶。
SLA_JAVA_OPTS=-Xmx512m -Xms192m
