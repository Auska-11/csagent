# ===== 闲鱼侧车配置 =====
# 复制为 .env 后填写；.env 永远不进仓库。

# 闲鱼 Cookie：电脑浏览器登录 https://www.goofish.com →
# F12 → Network → 刷新页面 → 点任一请求 → Request Headers →
# 复制整行 Cookie 值（必须含 unb=）。有时效性，失效重取。
COOKIES_STR=your_cookies_here

# 运行模式：ECHO = 本地回显（X1 协议验证）；BRIDGE = 转发 Java 客服 Agent（X3+）
SIDECAR_MODE=ECHO

# Java 客服 Agent 地址与侧车服务令牌（BRIDGE 模式必填；X2 提供）
# 令牌须与 Java 侧 SMARTCS_XIANYU_SERVICE_TOKEN 一致，且不少于 32 字节
# CS_AGENT_URL=http://localhost:8080
# CS_AGENT_TOKEN=

# Java 失败时发给买家的兜底话术；留空 = 不回复只记日志
# FALLBACK_REPLY=亲，稍等一下哈，马上回来~

# 心跳/连接（上游默认值，一般不用改）
# HEARTBEAT_INTERVAL=15
# HEARTBEAT_TIMEOUT=5
# TOKEN_REFRESH_INTERVAL=3600
# TOKEN_RETRY_INTERVAL=300
# MESSAGE_EXPIRE_TIME=300000

# 人工接管：卖家本人在闲鱼 App 会话里发送该关键词切换自动/人工
# TOGGLE_KEYWORDS=。
# MANUAL_MODE_TIMEOUT=3600

# X4 加固：每个会话首条自动回复末尾追加一次的免责话术；置空 = 关闭
# DISCLAIMER_TEXT=（本条由智能助手自动回复，如需人工服务请直接说明）

# 风控缓解
# REPLY_MIN_INTERVAL=3.5          # 同一买家两次回复最小间隔秒数
# SIMULATE_HUMAN_TYPING=False     # 按字数模拟打字延迟

# 日志级别：INFO / DEBUG
# LOG_LEVEL=INFO
