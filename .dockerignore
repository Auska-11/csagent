.git
.idea
.vscode
.m2
# Dockerfile.prebuilt needs the prebuilt JAR in the build context: exclude the
# rest of target/ (eval-reports etc.), then re-allow only that JAR.
# NOTE: keep every line ASCII - Docker Desktop 24 BuildKit rejects non-ASCII
# ignore rules (see DockerDeploymentConfigurationTest).
target/*
!target/smart-cs-agent-0.0.1-SNAPSHOT.jar
build
*.log
app.log
.env
.env.*
!.env.example
docs
frontend/node_modules
frontend/dist
frontend/dist
frontend/*.tsbuildinfo
