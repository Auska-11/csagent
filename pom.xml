<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.0</version>
        <relativePath/>
    </parent>

    <groupId>com.smartcs</groupId>
    <artifactId>smart-cs-agent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>smart-cs-agent</name>
    <description>智能客服 Agent</description>

    <properties>
        <java.version>17</java.version>
        <langchain4j.version>0.35.0</langchain4j.version>
    </properties>

    <dependencies>
        <!-- Spring Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 参数校验：用于 @Valid、@NotBlank 等注解，让接口边界更清晰 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
            Actuator 只暴露 health 端点，用于区分“进程存活”和“数据库依赖已就绪”。
            env、configprops 等可能包含敏感配置的管理端点不会对外开放。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--
            HTTP 认证和角色权限统一交给 Spring Security。
            Resource Server 会验证 Bearer JWT 的签名、有效期、issuer 和 audience，Controller 不再手工解析 token。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- LangChain4j 核心 -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j</artifactId>
            <version>${langchain4j.version}</version>
            <exclusions>
                <!--
                    当前项目没有使用 LangChain4j 中依赖 OpenNLP 的文本切分能力。
                    Windows/JDK17 环境下，javac 扫描 opennlp-tools.jar 时偶发 ZipFS AccessDeniedException。
                    排除它可以让本地编译和测试更稳定，不影响当前 ChatLanguageModel 调用链路。
                -->
                <exclusion>
                    <groupId>org.apache.opennlp</groupId>
                    <artifactId>opennlp-tools</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- LangChain4j Spring Boot 集成 -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-spring-boot-starter</artifactId>
            <version>${langchain4j.version}</version>
            <exclusions>
                <!--
                    starter 内部也会引入 langchain4j，因此这里同样排除 opennlp-tools，
                    避免它通过另一条依赖路径重新进入编译 classpath。
                -->
                <exclusion>
                    <groupId>org.apache.opennlp</groupId>
                    <artifactId>opennlp-tools</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- OpenAI 兼容（大多数模型都兼容 OpenAI 格式） -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-open-ai-spring-boot-starter</artifactId>
            <version>${langchain4j.version}</version>
        </dependency>

        <!-- MySQL JDBC 驱动：只有开启 JDBC 持久化模式时才会真正连接数据库 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            JDBC 模式内部统一使用 MyBatis。Starter 同时接入 Spring JDBC 事务与 HikariCP；
            DataSource 仍由 smartcs.persistence.jdbc.* 条件配置，memory 模式不会创建连接池。
        -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>3.0.3</version>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            Agent Skill 的 manifest 使用 YAML 编写。
            Spring Boot 本身可能通过其他依赖间接带入 SnakeYAML，但这里显式声明，
            是为了告诉维护者“Skill Loader 直接依赖它”，避免以后删掉某个 starter 时
            YAML 解析能力也被意外一起删掉。
        -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <exclusions>
                <!-- 当前测试统一使用 JUnit Assertions，没有使用 AssertJ 的 assertThat。
                     排除它可以减少测试依赖，也避免 Windows 环境下 assertj-core.jar 被 ZipFS 读取时偶发 AccessDenied。 -->
                <exclusion>
                    <groupId>org.assertj</groupId>
                    <artifactId>assertj-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- MockMvc 的认证 RequestPostProcessor，用于验证 401 / 403 和角色矩阵。 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- MyBatis Mapper、Hikari 与 Spring 事务的默认 CI 集成测试数据库。 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- 保留 Spring Boot 默认的 src/main/resources。 -->
            <resource>
                <directory>src/main/resources</directory>
            </resource>

            <!--
                根目录 skills/ 是 Skill Package 的唯一源码位置。
                targetPath=skills 表示打包后它仍位于 classpath:/skills/ 下。
                这样开发者只维护一份文件，不需要在两个目录之间手工复制。
            -->
            <resource>
                <directory>${project.basedir}/skills</directory>
                <targetPath>skills</targetPath>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!--
                        Windows 环境下，Maven 默认使用“当前 JVM 内置编译器”编译。
                        少数依赖 jar 被 JDK ZipFS 读取后，关闭文件系统时可能偶发 AccessDeniedException。
                        fork=true 表示改用独立 javac 进程编译，能减少这种本地文件句柄问题，不影响业务代码。
                    -->
                    <fork>true</fork>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
